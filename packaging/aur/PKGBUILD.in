# Maintainer: Caio Quirino <caioquirino at users dot noreply dot github dot com>
# Generated by scripts/package_linux.sh for each release; publish it to the AUR as pyromirror-bin.
pkgname=pyromirror-bin
pkgver=@PKGVER@
pkgrel=1
pkgdesc="Low-latency remote desktop for local networks, built on the PyroWave codec"
arch=('x86_64')
url="https://github.com/caioquirino/pyromirror"
license=('Apache-2.0')
depends=('libpipewire' 'vulkan-icd-loader' 'libglvnd' 'libxkbcommon' 'xdg-desktop-portal')
provides=('pyromirror')
conflicts=('pyromirror')
_version=@VERSION@
source=("$url/releases/download/v$_version/pyromirror-$_version-linux-x86_64.tar.gz"
        "pyromirror-$_version.desktop::https://raw.githubusercontent.com/caioquirino/pyromirror/v$_version/packaging/linux/pyromirror.desktop"
        "pyromirror-$_version.png::https://raw.githubusercontent.com/caioquirino/pyromirror/v$_version/packaging/linux/pyromirror.png")
sha256sums=('@SHA256@'
            'SKIP'
            'SKIP')

package() {
    cd "pyromirror-$_version-linux-x86_64"
    # The programs look for each other and for the PyroWave library next to themselves.
    install -Dm755 pyromirror pyromirror-server pyromirror-client -t "$pkgdir/usr/lib/pyromirror"
    install -Dm644 libpyrowave-shared.so.0 -t "$pkgdir/usr/lib/pyromirror"
    install -d "$pkgdir/usr/bin"
    for bin in pyromirror pyromirror-server pyromirror-client; do
        ln -s "/usr/lib/pyromirror/$bin" "$pkgdir/usr/bin/$bin"
    done
    install -Dm644 LICENSE NOTICE -t "$pkgdir/usr/share/licenses/$pkgname"
    install -Dm644 "$srcdir/pyromirror-$_version.desktop" "$pkgdir/usr/share/applications/pyromirror.desktop"
    install -Dm644 "$srcdir/pyromirror-$_version.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/pyromirror.png"
}
